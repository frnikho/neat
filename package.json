{
	"name": "neat-re",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev build_editor_css",
		"lint": "turbo run lint",
		"format": "prettier --write \"**/*.{ts,tsx,md}\"",
		"check-types": "turbo run check-types"
	},
	"devDependencies": {
		"@biomejs/biome": "2.1.4",
		"turbo": "^2.5.5",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=18"
	},
	"packageManager": "bun@1.2.19",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"bun-types": "latest",
			"typescript": "5.9.2"
		}
	}
}
