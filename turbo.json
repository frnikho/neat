{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"tasks": {
        "build_editor_css": {
          "cache": false,
          "persistent": true
        },
		"build": {
			"dependsOn": ["^build"],
			"inputs": ["$TURBO_DEFAULT$", ".env*"],
			"outputs": [".output", "."]
		},
		"lint": {
			"dependsOn": ["^lint"]
		},
		"check-types": {
			"dependsOn": ["^check-types"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		}
	}
}
